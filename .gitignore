# Local source files and exports can contain personal data. Only the
# existing .gitkeep files may ever be tracked; synthetic fixtures
# belong under tests/fixtures/.
escalatielogs/*
!escalatielogs/.gitkeep

exports/*
!exports/.gitkeep
to-do/

# Exports and reports containing personal data may never be tracked;
# synthetic fixtures belong only under tests/fixtures/.
*.xlsx
!tests/fixtures/*.xlsx
escalatie_log_controle_*

# Other project-local files.
.DS_Store
project-overview.md
.env

# Python tooling.
.venv
.venv/
venv/
*.pyc
__pycache__/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
