#!/bin/bash
set -euo pipefail

readonly REMOTE_NAME="$1"
readonly REPO_ROOT="$(git rev-parse --show-toplevel)"
readonly ZERO_OID_PATTERN='^0+$'

while read -r local_ref local_oid remote_ref remote_oid; do
  if [[ "${local_oid}" =~ ${ZERO_OID_PATTERN} ]]; then
    continue
  fi

  if [[ "${remote_oid}" =~ ${ZERO_OID_PATTERN} ]]; then
    while IFS= read -r commit; do
      "${REPO_ROOT}/scripts/check-sensitive-paths.sh" \
        --range "${commit}^!"
    done < <(git rev-list "${local_oid}" --not --remotes="${REMOTE_NAME}")
  else
    "${REPO_ROOT}/scripts/check-sensitive-paths.sh" \
      --range "${remote_oid}..${local_oid}"
  fi
done
